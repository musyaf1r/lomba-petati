
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model Panen{
  id String @id@default(uuid())
  name String
  userId String
  createdAt DateTime @default(now())
  updateDat DateTime @updatedAt
  lahan Lahan[]
  produk Produk[]
}
model Lahan {
  id          String   @id @default(uuid())
  panenId     String
  Panen       Panen    @relation(fields: [panenId], references: [id])
  nama        String
  lokasi      String
  luas        Float   
  komoditas   String?  
  status      String   @default("kosong") 
  tanggalTanam DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hasilPanen  HasilPanen[]
}

model HasilPanen {
  id            String   @id @default(uuid())
  lahanId       String
  lahan         Lahan    @relation(fields: [lahanId], references: [id])
  jumlahHasil   Float    
  satuan        String   @default("kg")
  hargaSaatPanen Float   
  totalPendapatan Float   @default(0) 
  tanggalPanen  DateTime @default(now())
  createdAt     DateTime @default(now())
}
model Produk {
  id          String   @id @default(uuid())
  panenId     String
  panen       Panen    @relation(fields: [panenId], references: [id])
  namaPetani  String
  namaBarang  String
  daerah     String @default("-")
  hargaJual   Float
  stok        Float
  satuan      String   @default("kg")
  fotoUrl     String?
  nomorHp     String
  createdAt   DateTime @default(now())
}
